.env
__pycache__/
*.pyc
.claude/

# API 원자료 중 국토부 실거래 건별 자료(V006·V007)는 수 GB 규모라 제외.
# collect/collect_molit.py 로 언제든 다시 받을 수 있다. 나머지 raw(KOSIS·R-ONE·ECOS 등)는 올린다.
raw/*/V006_*/
raw/*/V007_*/
raw/_수집로그_*.txt
raw/_수집오류_*.txt

# TH 실험: 인증정보와 재생성 가능한 로컬 학습·점검 파일은 제외.
ml/experiments_TH_v1/**/.env*
ml/experiments_TH_v1/**/.runtime*/
ml/experiments_TH_v1/**/analysis/output_TH_*/models_TH_*/
ml/experiments_TH_v1/**/analysis/output_TH_*/parts_TH_*/
ml/experiments_TH_v1/**/analysis/output_TH_*/*_model_ready_TH_v*.csv
ml/experiments_TH_v1/**/qa_TH_*/
ml/experiments_TH_v1/**/reports_TH_*/
ml/experiments_TH_v1/**/*.zip
# 원형 예측 CSV에서 재생성하는 한글 양식 사본(중복 대용량).
ml/output/TH_v*/예측값_TH_v*.csv
